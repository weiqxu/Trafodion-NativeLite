-- Portable single-byte REPEAT coverage adapted from core/TEST038. Explicit
-- UTF8/UCS2 variants remain outside this case.
SELECT REPEAT('ab', 3) AS repeated_txt,
       CASE WHEN REPEAT('', 5) = '' THEN 'MATCH' ELSE 'DIFFERENT' END
         AS empty_state,
       CASE WHEN REPEAT(CAST(NULL AS VARCHAR(1)), 3) IS NULL
            THEN 'NULL' ELSE 'VALUE' END AS null_state,
       CHAR_LENGTH(REPEAT('xy', 0)) AS zero_length,
       CONVERTTOHEX(REPEAT('A ', 2)) AS trailing_hex
  FROM (VALUES (1)) AS v(n);

CREATE TABLE LITEREG025_REPEAT_SOURCE
  (id INT PRIMARY KEY,
   source_txt VARCHAR(8),
   repeat_count INT,
   expected_txt VARCHAR(32));

INSERT INTO LITEREG025_REPEAT_SOURCE VALUES
  (2, 'x', 1, 'x'),
  (3, 'xy', 3, 'xyxyxy'),
  (4, 'xy', 0, ''),
  (5, '', 5, ''),
  (6, NULL, 3, NULL),
  (7, 'ab', NULL, NULL),
  (8, 'A ', 2, 'A A '),
  (9, 'z', 8, 'zzzzzzzz'),
  (10, 'neg', -1, NULL);

CREATE TABLE LITEREG025_REPEAT_RESULTS
  (id INT PRIMARY KEY,
   repeated_txt VARCHAR(32),
   expected_txt VARCHAR(32),
   wrapped_txt VARCHAR(34));

-- Cover assignment through both INSERT VALUES and INSERT SELECT. Dynamic
-- count results are stored in bounded VARCHAR columns before display because
-- their unconstrained expression type uses the maximum character length.
INSERT INTO LITEREG025_REPEAT_RESULTS VALUES
  (1, REPEAT('ab', 3), 'ababab', '[' || REPEAT('ab', 3) || ']');

INSERT INTO LITEREG025_REPEAT_RESULTS
SELECT id,
       REPEAT(source_txt, repeat_count),
       expected_txt,
       '[' || REPEAT(source_txt, repeat_count) || ']'
  FROM LITEREG025_REPEAT_SOURCE
 WHERE id < 10;

-- Hex output makes zero-length results and preserved trailing spaces explicit.
SELECT id,
       CASE
         WHEN repeated_txt IS NULL AND expected_txt IS NULL THEN 'BOTH_NULL'
         WHEN repeated_txt = expected_txt THEN 'MATCH'
         ELSE 'DIFFERENT'
       END AS result_state,
       CHAR_LENGTH(repeated_txt) AS repeated_length,
       CONVERTTOHEX(repeated_txt) AS repeated_hex,
       CONVERTTOHEX(wrapped_txt) AS wrapped_hex
  FROM LITEREG025_REPEAT_RESULTS
 ORDER BY id;

-- Exercise REPEAT directly in predicates over stored string/count arguments.
SELECT id
  FROM LITEREG025_REPEAT_SOURCE
 WHERE id < 10
   AND REPEAT(source_txt, repeat_count) = expected_txt
 ORDER BY id;

SELECT id
  FROM LITEREG025_REPEAT_SOURCE
 WHERE id < 10
   AND REPEAT(source_txt, repeat_count) IS NULL
 ORDER BY id;

SELECT id
  FROM LITEREG025_REPEAT_RESULTS
 WHERE repeated_txt = 'xyxyxy'
 ORDER BY id;

SELECT id
  FROM LITEREG025_REPEAT_RESULTS
 WHERE wrapped_txt = '[' || REPEAT('A ', 2) || ']'
 ORDER BY id;

-- Preserve deterministic invalid and oversized count diagnostics. Projecting
-- CHAR_LENGTH avoids formatting the unconstrained dynamic result type.
SELECT CHAR_LENGTH(REPEAT(source_txt, repeat_count)) AS negative_length
  FROM LITEREG025_REPEAT_SOURCE
 WHERE id = 10;

SELECT CHAR_LENGTH(REPEAT('ab', 2147483647)) AS oversized_length
  FROM (VALUES (1)) AS v(n);

SELECT CHAR_LENGTH(REPEAT('ab', 9999999999999999999)) AS invalid_length
  FROM (VALUES (1)) AS v(n);

-- Errors must not poison the session or persisted result table.
SELECT id, repeated_txt AS recovered_repeat
  FROM LITEREG025_REPEAT_RESULTS
 WHERE id = 9;

DROP TABLE LITEREG025_REPEAT_RESULTS;
DROP TABLE LITEREG025_REPEAT_SOURCE;
exit;
