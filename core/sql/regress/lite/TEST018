-- Portable single-byte CONVERTTOHEX coverage adapted from charsets/TEST313.
CREATE TABLE LITEREG018_HEX_SOURCE
  (id INT PRIMARY KEY,
   fixed_txt CHAR(4),
   varying_txt VARCHAR(8));

INSERT INTO LITEREG018_HEX_SOURCE VALUES
  (1, 'Ab0', 'abc'),
  (2, '', ''),
  (3, 'A ', 'A '),
  (4, NULL, NULL);

-- Hex output is uppercase and preserves every source byte, including the
-- complete ISO88591 byte boundaries.
SELECT CONVERTTOHEX(_ISO88591'Ab0') AS literal_hex,
       CONVERTTOHEX(CHAR(0) || CHAR(127) || CHAR(128) || CHAR(255))
         AS boundary_hex
  FROM (VALUES (1)) AS v(n);

-- Fixed CHAR padding is encoded, while VARCHAR uses its stored length. Empty
-- strings stay empty and NULL propagates.
SELECT id,
       CONVERTTOHEX(fixed_txt) AS fixed_hex,
       CONVERTTOHEX(varying_txt) AS varying_hex,
       CHAR_LENGTH(CONVERTTOHEX(varying_txt)) AS varying_hex_len
  FROM LITEREG018_HEX_SOURCE
 ORDER BY id;

-- Assignment preserves generated values, zero length, and NULL state.
CREATE TABLE LITEREG018_HEX_TEXT
  (id INT PRIMARY KEY,
   encoded VARCHAR(32));

INSERT INTO LITEREG018_HEX_TEXT
SELECT id, CONVERTTOHEX(varying_txt)
  FROM LITEREG018_HEX_SOURCE;

SELECT id, encoded, CHAR_LENGTH(encoded) AS encoded_len
  FROM LITEREG018_HEX_TEXT
 ORDER BY id;

-- The generated hexadecimal text remains usable in local-table predicates.
SELECT id
  FROM LITEREG018_HEX_SOURCE
 WHERE CONVERTTOHEX(varying_txt) = '616263'
 ORDER BY id;

SELECT id
  FROM LITEREG018_HEX_SOURCE
 WHERE CONVERTTOHEX(varying_txt) = ''
 ORDER BY id;

DROP TABLE LITEREG018_HEX_TEXT;
DROP TABLE LITEREG018_HEX_SOURCE;
exit;
