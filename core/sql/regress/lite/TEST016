-- Portable single-byte ASCII/CHAR coverage adapted from charsets/TEST313.
CREATE TABLE LITEREG016_CODE_ROWS
  (id INT PRIMARY KEY,
   txt VARCHAR(12),
   code_num INT);

INSERT INTO LITEREG016_CODE_ROWS VALUES
  (1, 'alpha', 97),
  (2, 'Beta', 66),
  (3, '9lives', 57),
  (4, ' space', 32),
  (5, '', 65),
  (6, NULL, NULL),
  (7, 'zeta', 90);

-- ASCII returns the first byte, returns zero for an empty string, and
-- propagates NULL. CHAR accepts stored integer expressions.
SELECT id,
       ASCII(txt) AS first_code,
       CHAR(code_num) AS code_char
  FROM LITEREG016_CODE_ROWS
 ORDER BY id;

-- Exercise the complete endpoints and the signed-byte boundary without
-- rendering control or high-bit characters directly.
SELECT code_num,
       ASCII(CHAR(code_num)) AS roundtrip_code
  FROM (VALUES (0), (65), (127), (128), (255)) AS codes(code_num)
 ORDER BY code_num;

SELECT ASCII(CHAR(97, ISO88591)) AS iso88591_roundtrip
  FROM (VALUES (1)) AS v(n);

-- Preserve scalar-subquery values and NULL generated by an empty subquery.
SELECT ASCII((SELECT txt
                FROM LITEREG016_CODE_ROWS
               WHERE id = 2)) AS scalar_subquery_code
  FROM (VALUES (1)) AS v(n);

SELECT CASE WHEN ASCII((SELECT txt
                          FROM LITEREG016_CODE_ROWS
                         WHERE id = 99)) IS NULL
            THEN 'NULL' ELSE 'VALUE' END AS empty_subquery_state
  FROM (VALUES (1)) AS v(n);

-- Round trips remain usable as predicates over persisted local rows.
SELECT id
  FROM LITEREG016_CODE_ROWS
 WHERE ASCII(txt) = code_num
 ORDER BY id;

SELECT id
  FROM LITEREG016_CODE_ROWS
 WHERE CHAR(code_num) = SUBSTRING(txt FROM 1 FOR 1)
 ORDER BY id;

-- An out-of-range ISO88591 code keeps its deterministic diagnostic and must
-- not poison later expression evaluation.
SELECT CHAR(256) AS too_high
  FROM (VALUES (1)) AS v(n);

SELECT ASCII('recovered') AS recovered_code
  FROM (VALUES (1)) AS v(n);

DROP TABLE LITEREG016_CODE_ROWS;
exit;
