CREATE TABLE LITEREG029_TARGET
  (id INT NOT NULL PRIMARY KEY, code VARCHAR(8), label VARCHAR(20), UNIQUE(code));
CREATE TABLE LITEREG029_SOURCE
  (id INT NOT NULL PRIMARY KEY, code VARCHAR(8), label VARCHAR(20));

INSERT INTO LITEREG029_TARGET VALUES
  (1, 'A', 'old-one'),
  (2, 'B', 'old-two');
INSERT INTO LITEREG029_SOURCE VALUES
  (1, 'A', 'new-one'),
  (3, 'C', 'new-three');

MERGE INTO LITEREG029_TARGET
USING (SELECT * FROM LITEREG029_SOURCE) AS s
ON LITEREG029_TARGET.id = s.id
WHEN MATCHED THEN UPDATE SET label = s.label
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.code, s.label);

SELECT id, code, label FROM LITEREG029_TARGET ORDER BY id;

DELETE FROM LITEREG029_SOURCE;
INSERT INTO LITEREG029_SOURCE VALUES
  (1, 'A', 'txn-one'),
  (4, 'D', 'txn-four');

BEGIN WORK;

MERGE INTO LITEREG029_TARGET
USING (SELECT * FROM LITEREG029_SOURCE) AS s
ON LITEREG029_TARGET.id = s.id
WHEN MATCHED THEN UPDATE SET label = s.label
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.code, s.label);

SELECT id, code, label FROM LITEREG029_TARGET
 WHERE id IN (1, 4) ORDER BY id;

ROLLBACK WORK;

SELECT id, code, label FROM LITEREG029_TARGET
 WHERE id IN (1, 4) ORDER BY id;

DELETE FROM LITEREG029_SOURCE;
INSERT INTO LITEREG029_SOURCE VALUES
  (1, 'X', 'must-roll-back'),
  (5, 'B', 'duplicate-unique');

MERGE INTO LITEREG029_TARGET
USING (SELECT * FROM LITEREG029_SOURCE) AS s
ON LITEREG029_TARGET.id = s.id
WHEN MATCHED THEN UPDATE SET code = s.code, label = s.label
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.code, s.label);

SELECT id, code, label FROM LITEREG029_TARGET
 WHERE id IN (1, 5) ORDER BY id;

DELETE FROM LITEREG029_SOURCE;
INSERT INTO LITEREG029_SOURCE VALUES
  (2, 'B', 'skip'),
  (4, 'D', 'insert-four');

MERGE INTO LITEREG029_TARGET
USING (SELECT * FROM LITEREG029_SOURCE) AS s
ON LITEREG029_TARGET.id = s.id
WHEN MATCHED THEN UPDATE SET label = s.label WHERE s.label <> 'skip'
WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.code, s.label);

SELECT id, code, label FROM LITEREG029_TARGET ORDER BY id;

DROP TABLE LITEREG029_SOURCE;
DROP TABLE LITEREG029_TARGET;
exit;
