-- Complete RocksDB ordered secondary-index coverage for datetime, wide
-- decimal, covering values, candidate selection, and nullable composites.

CREATE TABLE LITEREG035_DT
  (id INT NOT NULL PRIMARY KEY, d DATE, tm TIME, ts TIMESTAMP,
   label VARCHAR(20));
INSERT INTO LITEREG035_DT VALUES
  (1, DATE '1999-12-31', TIME '23:59:59',
      TIMESTAMP '1999-12-31 23:59:59.000000', 'old'),
  (2, DATE '2025-01-01', TIME '00:00:01',
      TIMESTAMP '2025-01-01 00:00:01.100000', 'new-year'),
  (3, DATE '2025-06-15', TIME '12:30:45',
      TIMESTAMP '2025-06-15 12:30:45.250000', 'summer'),
  (4, NULL, NULL, NULL, 'null-value');
CREATE INDEX LITEREG035_D_IX ON LITEREG035_DT(d);
CREATE INDEX LITEREG035_TM_IX ON LITEREG035_DT(tm DESC);
CREATE INDEX LITEREG035_TS_IX ON LITEREG035_DT(ts);
SELECT id, label FROM LITEREG035_DT
 WHERE d >= DATE '2025-01-01' ORDER BY id;
SELECT id, label FROM LITEREG035_DT
 WHERE tm < TIME '12:30:45' ORDER BY id;
SELECT id, label FROM LITEREG035_DT
 WHERE ts = TIMESTAMP '2025-06-15 12:30:45.250000' ORDER BY id;
SELECT id, label FROM LITEREG035_DT WHERE d IS NULL ORDER BY id;
UPDATE LITEREG035_DT SET label = 'covered-update'
 WHERE d = DATE '2025-01-01';
SELECT id, label FROM LITEREG035_DT
 WHERE d = DATE '2025-01-01' ORDER BY id;
DROP TABLE LITEREG035_DT;

CREATE TABLE LITEREG035_NUM
  (id INT NOT NULL PRIMARY KEY, decv DECIMAL(8,2),
   bigv NUMERIC(30,2), label VARCHAR(20));
INSERT INTO LITEREG035_NUM VALUES
  (1, -100.25, -9999999999999999999999999999.99, 'negative'),
  (2, 0.00, 0.00, 'zero'),
  (3, 10.50, 1234567890123456789012345678.90, 'positive'),
  (4, NULL, NULL, 'null-value');
CREATE INDEX LITEREG035_DEC_IX ON LITEREG035_NUM(decv);
CREATE INDEX LITEREG035_BIG_IX ON LITEREG035_NUM(bigv DESC);
SELECT id, label FROM LITEREG035_NUM WHERE decv >= 0 ORDER BY id;
SELECT id, label FROM LITEREG035_NUM WHERE bigv < 0 ORDER BY id;
SELECT id, label FROM LITEREG035_NUM
 WHERE bigv = 1234567890123456789012345678.90 ORDER BY id;
SELECT id, label FROM LITEREG035_NUM WHERE bigv IS NULL ORDER BY id;
DROP TABLE LITEREG035_NUM;

CREATE TABLE LITEREG035_NULLS
  (id INT NOT NULL PRIMARY KEY, a INT, b INT, c INT,
   label VARCHAR(20));
INSERT INTO LITEREG035_NULLS VALUES
  (1, NULL, NULL, 1, 'both-null'),
  (2, NULL, 5, 10, 'null-range-low'),
  (3, NULL, 5, 20, 'null-range-high'),
  (4, 1, 5, 20, 'not-null');
CREATE INDEX LITEREG035_NULL_IX ON LITEREG035_NULLS(a, b, c);
CREATE INDEX LITEREG035_A_IX ON LITEREG035_NULLS(a);
SELECT id, label FROM LITEREG035_NULLS
 WHERE a IS NULL AND b IS NULL ORDER BY id;
SELECT id, label FROM LITEREG035_NULLS
 WHERE a IS NULL AND b = 5 AND c > 10 ORDER BY id;
SELECT id, label FROM LITEREG035_NULLS
 WHERE a IS NULL AND b = 5 AND c = 20 ORDER BY id;
DROP TABLE LITEREG035_NULLS;

