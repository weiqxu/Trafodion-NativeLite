-- Explicit transaction commit/rollback and per-table primary-key atomicity.
CREATE TABLE LITEREG002_TX (id INT, value VARCHAR(24));

BEGIN WORK;
INSERT INTO LITEREG002_TX VALUES (1, 'rollback-row');
SELECT value FROM LITEREG002_TX WHERE id = 1;
ROLLBACK WORK;
SELECT value FROM LITEREG002_TX WHERE id = 1;

BEGIN WORK;
INSERT INTO LITEREG002_TX VALUES (2, 'commit-row'), (3, 'second-row');
COMMIT WORK;
SELECT id, value FROM LITEREG002_TX ORDER BY id;

CREATE TABLE LITEREG002_PK (id INT PRIMARY KEY, value VARCHAR(24));
INSERT INTO LITEREG002_PK VALUES (2, 'committed-row');
BEGIN WORK;
INSERT INTO LITEREG002_PK VALUES
  (1, 'must-not-commit'),
  (2, 'duplicate-row');
COMMIT WORK;
SELECT id, value FROM LITEREG002_PK ORDER BY id;

DROP TABLE LITEREG002_PK;
DROP TABLE LITEREG002_TX;
exit;
