-- M6 RocksDB-only character and scalar type coverage.

CONTROL QUERY DEFAULT TRAF_BINARY_SUPPORT 'ON';
CREATE TABLE LITEREG039_T
  (id INT NOT NULL PRIMARY KEY,
   u8 VARCHAR(20) CHARACTER SET UTF8,
   u2 VARCHAR(10) CHARACTER SET UCS2,
   b BOOLEAN,
   bin BINARY(4),
   vb VARBINARY(4),
   lv LONG VARCHAR,
   iv INTERVAL DAY(3) TO SECOND(6));
CREATE INDEX LITEREG039_IX ON LITEREG039_T (b, bin);
SHOWDDL LITEREG039_T;
INSERT INTO LITEREG039_T VALUES
  (1, '你好', _UCS2'世界', TRUE, X'0102', X'0304', 'long text', INTERVAL '1 02:03:04.000005' DAY TO SECOND);
SELECT id, u8, u2, b, bin, vb, lv, iv FROM LITEREG039_T;
SELECT id FROM LITEREG039_T WHERE b = TRUE;
SELECT id FROM LITEREG039_T WHERE bin = CAST(X'01020000' AS BINARY(4));
UPDATE LITEREG039_T SET b = FALSE, u8 = '再见' WHERE id = 1;
SELECT id, b, u8 FROM LITEREG039_T;
DROP INDEX LITEREG039_IX;
DROP TABLE LITEREG039_T;
exit;
