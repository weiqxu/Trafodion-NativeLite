-- Portable UNION/derived-table coverage adapted from executor/TEST002, plus
-- correlated subquery shapes adapted from core/TEST002.
CREATE TABLE LITEREG006_LEFT_ROWS
  (id INT PRIMARY KEY,
   grp INT,
   val INT);

CREATE TABLE LITEREG006_RIGHT_ROWS
  (id INT PRIMARY KEY,
   grp INT,
   score INT);

INSERT INTO LITEREG006_LEFT_ROWS VALUES
  (1, 10, 5),
  (2, 10, 8),
  (3, 20, 3),
  (4, 30, NULL),
  (5, 40, 9);

INSERT INTO LITEREG006_RIGHT_ROWS VALUES
  (101, 10, 7),
  (102, 20, 4),
  (103, 20, 6),
  (104, 40, 10),
  (105, 50, 1);

SELECT grp
  FROM LITEREG006_LEFT_ROWS
  WHERE grp <= 20
UNION ALL
SELECT grp
  FROM LITEREG006_RIGHT_ROWS
  WHERE grp <= 20
ORDER BY 1;

SELECT grp
  FROM LITEREG006_LEFT_ROWS
UNION
SELECT grp
  FROM LITEREG006_RIGHT_ROWS
ORDER BY 1;

SELECT u.grp, COUNT(*) AS occurrences, SUM(u.val) AS total
  FROM (SELECT grp, val
          FROM LITEREG006_LEFT_ROWS
        UNION ALL
        SELECT grp, score
          FROM LITEREG006_RIGHT_ROWS) AS u(grp, val)
  GROUP BY u.grp
  ORDER BY u.grp;

SELECT l.grp, l.total AS left_total, r.total AS right_total
  FROM (SELECT grp, SUM(val) AS total
          FROM LITEREG006_LEFT_ROWS
         GROUP BY grp) AS l
  JOIN (SELECT grp, SUM(score) AS total
          FROM LITEREG006_RIGHT_ROWS
         GROUP BY grp) AS r
    ON l.grp = r.grp
  ORDER BY l.grp;

SELECT l.id
  FROM LITEREG006_LEFT_ROWS AS l
  WHERE EXISTS
        (SELECT 1
           FROM LITEREG006_RIGHT_ROWS AS r
          WHERE r.grp = l.grp
            AND r.score > l.val)
  ORDER BY l.id;

SELECT l.id
  FROM LITEREG006_LEFT_ROWS AS l
  WHERE NOT EXISTS
        (SELECT 1
           FROM LITEREG006_RIGHT_ROWS AS r
          WHERE r.grp = l.grp)
  ORDER BY l.id;

SELECT l.id,
       (SELECT MAX(r.score)
          FROM LITEREG006_RIGHT_ROWS AS r
         WHERE r.grp = l.grp) AS max_score
  FROM LITEREG006_LEFT_ROWS AS l
  ORDER BY l.id;

SELECT l.id
  FROM LITEREG006_LEFT_ROWS AS l
  WHERE l.val <
        (SELECT AVG(r.score)
           FROM LITEREG006_RIGHT_ROWS AS r
          WHERE r.grp = l.grp)
  ORDER BY l.id;

DROP TABLE LITEREG006_RIGHT_ROWS;
DROP TABLE LITEREG006_LEFT_ROWS;
exit;
