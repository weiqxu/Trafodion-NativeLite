CREATE TABLE LITEREG032_RANGE
  (id INT NOT NULL PRIMARY KEY,
   grp VARCHAR(4),
   score INT,
   label VARCHAR(20));

INSERT INTO LITEREG032_RANGE VALUES
  (1, 'A', 10, 'a-ten'),
  (2, 'A', 20, 'a-twenty'),
  (3, 'A', 30, 'a-thirty'),
  (4, 'B', 15, 'b-fifteen'),
  (5, 'B', 25, 'b-twenty-five'),
  (6, NULL, 99, 'null-group'),
  (7, 'C', -10, 'negative'),
  (8, 'C', 0, 'zero');

CREATE INDEX LITEREG032_GS_IX ON LITEREG032_RANGE(grp, score DESC);

-- A leading equality scans only the matching composite-index prefix.
SELECT id, score FROM LITEREG032_RANGE WHERE grp = 'A' ORDER BY id;
SELECT id, score FROM LITEREG032_RANGE
 WHERE grp = 'A' AND score >= 20 ORDER BY id;
SELECT id, score FROM LITEREG032_RANGE
 WHERE grp = 'B' AND score BETWEEN 10 AND 20 ORDER BY id;

-- A non-leading predicate cannot use the composite index by itself.
SELECT id, score FROM LITEREG032_RANGE WHERE score >= 25 ORDER BY id;

CREATE INDEX LITEREG032_SCORE_IX ON LITEREG032_RANGE(score);
SELECT id, score FROM LITEREG032_RANGE
 WHERE score > 15 AND score <= 30 ORDER BY id;
SELECT id, score FROM LITEREG032_RANGE WHERE 25 < score ORDER BY id;
SELECT id, score FROM LITEREG032_RANGE WHERE score < 0 ORDER BY id;

-- Pending updates are filtered from the transaction-visible row set.
BEGIN WORK;
UPDATE LITEREG032_RANGE SET score = 40 WHERE id = 1;
SELECT id, score FROM LITEREG032_RANGE
 WHERE grp = 'A' AND score >= 35 ORDER BY id;
ROLLBACK WORK;
SELECT id, score FROM LITEREG032_RANGE
 WHERE grp = 'A' AND score >= 35 ORDER BY id;

DROP INDEX LITEREG032_SCORE_IX;
DROP INDEX LITEREG032_GS_IX;
DROP TABLE LITEREG032_RANGE;
exit;
