-- Portable GROUP_CONCAT coverage adapted from executor/TEST002.
CREATE TABLE LITEREG014_GROUP_ROWS
  (id INT PRIMARY KEY,
   grp VARCHAR(8),
   score INT,
   label VARCHAR(16));

INSERT INTO LITEREG014_GROUP_ROWS VALUES
  (1, 'g1', 30, 'three'),
  (2, 'g1', 10, 'one'),
  (3, 'g1', 20, 'two'),
  (4, 'g1', 20, 'two-b'),
  (5, 'g1', NULL, 'missing'),
  (6, 'g2', 5, 'five'),
  (7, 'g2', 15, 'fifteen'),
  (8, 'g2', 5, 'five-b'),
  (9, 'g3', NULL, 'none-a'),
  (10, 'g3', NULL, 'none-b'),
  (11, 'g4', 1, ''),
  (12, 'g4', 2, 'tail');

-- NULL inputs are ignored regardless of where they occur in the aggregate's
-- requested order; an all-NULL group remains NULL.
SELECT grp,
       CAST(GROUP_CONCAT(score ORDER BY score SEPARATOR '-')
            AS VARCHAR(30)) AS scores
  FROM LITEREG014_GROUP_ROWS
 GROUP BY grp
 ORDER BY grp;

SELECT grp,
       CAST(GROUP_CONCAT(DISTINCT score
                         ORDER BY score DESC SEPARATOR ':')
            AS VARCHAR(30)) AS distinct_scores
  FROM LITEREG014_GROUP_ROWS
 GROUP BY grp
 ORDER BY grp;

-- The order key need not be the expression being concatenated. An empty
-- string is still a value, so the following non-empty value retains its
-- separator.
SELECT grp,
       CAST(GROUP_CONCAT(label ORDER BY id SEPARATOR '|')
            AS VARCHAR(80)) AS labels
  FROM LITEREG014_GROUP_ROWS
 GROUP BY grp
 ORDER BY grp;

-- The default separator is a comma.
SELECT CAST(GROUP_CONCAT(label ORDER BY id)
            AS VARCHAR(120)) AS all_labels
  FROM LITEREG014_GROUP_ROWS;

SELECT CASE WHEN GROUP_CONCAT(score ORDER BY id) IS NULL
            THEN 'NULL' ELSE 'VALUE' END AS all_null_state
  FROM LITEREG014_GROUP_ROWS
 WHERE grp = 'g3';

SELECT CASE WHEN GROUP_CONCAT(score ORDER BY id) IS NULL
            THEN 'NULL' ELSE 'VALUE' END AS empty_state
  FROM LITEREG014_GROUP_ROWS
 WHERE grp = 'missing';

DROP TABLE LITEREG014_GROUP_ROWS;
exit;
