-- M8 RocksDB-only authorization coverage.

CREATE USER LITEREG041_BOB;
CREATE ROLE LITEREG041_ROLE;
CREATE TABLE LITEREG041_T (id INT PRIMARY KEY, v INT);
INSERT INTO LITEREG041_T VALUES (1, 10);

-- Role membership and object privileges are persisted in the RocksDB catalog.
GRANT SELECT, INSERT ON LITEREG041_T TO LITEREG041_ROLE;
GRANT LITEREG041_ROLE TO LITEREG041_BOB;

SET SESSION AUTHORIZATION LITEREG041_BOB;
VALUES (CURRENT_USER, SESSION_USER, USER);
SELECT id, v FROM LITEREG041_T;
INSERT INTO LITEREG041_T VALUES (2, 20);
PREPARE LITEREG041_P FROM SELECT id FROM LITEREG041_T ORDER BY id;
EXECUTE LITEREG041_P;

-- The creator owns a new table; ownership permits GRANT, while another
-- authenticated user cannot read or drop it until the owner grants SELECT.
SET SESSION AUTHORIZATION DB__ROOT;
CREATE USER LITEREG041_OWNER;
CREATE USER LITEREG041_OTHER;
SET SESSION AUTHORIZATION LITEREG041_OWNER;
CREATE TABLE LITEREG041_OWNED (id INT);
INSERT INTO LITEREG041_OWNED VALUES (7);
SET SESSION AUTHORIZATION LITEREG041_OTHER;
SELECT id FROM LITEREG041_OWNED;
DROP TABLE LITEREG041_OWNED;
SET SESSION AUTHORIZATION LITEREG041_OWNER;
GRANT SELECT ON LITEREG041_OWNED TO LITEREG041_OTHER;
SET SESSION AUTHORIZATION LITEREG041_OTHER;
SELECT id FROM LITEREG041_OWNED;

-- Revoke invalidates the next compilation; the active session cannot read
-- after the role's SELECT privilege is removed.
SET SESSION AUTHORIZATION DB__ROOT;
REVOKE SELECT ON LITEREG041_T FROM LITEREG041_ROLE;
SET SESSION AUTHORIZATION LITEREG041_BOB;
SELECT id FROM LITEREG041_T ORDER BY id;
EXECUTE LITEREG041_P;

SET SESSION AUTHORIZATION DB__ROOT;
DROP TABLE LITEREG041_T;
DROP TABLE LITEREG041_OWNED;
DROP ROLE LITEREG041_ROLE;
DROP USER LITEREG041_BOB;
DROP USER LITEREG041_OWNER;
DROP USER LITEREG041_OTHER;
exit;
