-- RocksDB-backed row and statement triggers, BEFORE SET/SIGNAL semantics,
-- multi-trigger ordering metadata, and trigger lifecycle cleanup.

CREATE TABLE LITEREG036_T
  (id INT NOT NULL PRIMARY KEY, v INT);
CREATE TABLE LITEREG036_AUDIT
  (seq INT NOT NULL PRIMARY KEY, event_name VARCHAR(20), seen_v INT);

CREATE TRIGGER LITEREG036_BI BEFORE INSERT ON LITEREG036_T
  REFERENCING NEW ROW AS n FOR EACH ROW
  SET n.v = n.v + 1;
CREATE TRIGGER LITEREG036_AI AFTER INSERT ON LITEREG036_T
  REFERENCING NEW ROW AS n FOR EACH ROW
  INSERT INTO LITEREG036_AUDIT VALUES
    (n.id * 10 + 1, 'after-insert', n.v);
INSERT INTO LITEREG036_T VALUES (1,10),(2,20);
SELECT * FROM LITEREG036_T ORDER BY id;
SELECT * FROM LITEREG036_AUDIT ORDER BY seq;
DROP TRIGGER LITEREG036_BI;
DROP TRIGGER LITEREG036_AI;

CREATE TRIGGER LITEREG036_BU BEFORE UPDATE ON LITEREG036_T
  REFERENCING OLD ROW AS o, NEW ROW AS n FOR EACH ROW
  SET n.v = n.v + 100;
CREATE TRIGGER LITEREG036_AU AFTER UPDATE OF (v) ON LITEREG036_T
  REFERENCING OLD ROW AS o, NEW ROW AS n FOR EACH ROW
  INSERT INTO LITEREG036_AUDIT VALUES
    (n.id * 10 + 2, 'after-update', n.v);
UPDATE LITEREG036_T SET v = v + 1;
SELECT * FROM LITEREG036_T ORDER BY id;
SELECT * FROM LITEREG036_AUDIT ORDER BY seq;
DROP TRIGGER LITEREG036_BU;

CREATE TRIGGER LITEREG036_BLOCK BEFORE UPDATE ON LITEREG036_T
  REFERENCING OLD ROW AS o, NEW ROW AS n FOR EACH ROW
  WHEN (o.id = 2) SIGNAL SQLSTATE 'S9999' ('blocked');
UPDATE LITEREG036_T SET v = v + 1000;
SELECT * FROM LITEREG036_T ORDER BY id;
SELECT * FROM LITEREG036_AUDIT ORDER BY seq;
DROP TRIGGER LITEREG036_BLOCK;
DROP TRIGGER LITEREG036_AU;

CREATE TRIGGER LITEREG036_AS AFTER INSERT ON LITEREG036_T
  FOR EACH STATEMENT
  INSERT INTO LITEREG036_AUDIT VALUES (999, 'after-statement', 0);
INSERT INTO LITEREG036_T VALUES (3,30),(4,40);
SELECT * FROM LITEREG036_AUDIT ORDER BY seq;
DROP TRIGGER LITEREG036_AS;
INSERT INTO LITEREG036_T VALUES (5,50);
SELECT * FROM LITEREG036_AUDIT ORDER BY seq;

DROP TABLE LITEREG036_T;
DROP TABLE LITEREG036_AUDIT;
exit;
