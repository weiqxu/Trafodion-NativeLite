CREATE TABLE LITEREG031_BASE
  (id INT NOT NULL PRIMARY KEY,
   code VARCHAR(8),
   label VARCHAR(20));

INSERT INTO LITEREG031_BASE VALUES
  (1, 'A', 'one'),
  (2, 'B', 'two'),
  (3, NULL, 'null-one'),
  (4, NULL, 'null-two');

-- Build the physical index from rows that already exist in RocksDB.
CREATE UNIQUE INDEX LITEREG031_UX ON LITEREG031_BASE(code);
SELECT id, label FROM LITEREG031_BASE WHERE code = 'A' ORDER BY id;

INSERT INTO LITEREG031_BASE VALUES (5, 'A', 'duplicate-insert');
INSERT INTO LITEREG031_BASE VALUES
  (5, 'C', 'must-roll-back'),
  (6, 'B', 'late-duplicate');
UPDATE LITEREG031_BASE SET code = 'A' WHERE id = 2;

-- DELETE must release the physical unique key for a later INSERT.
DELETE FROM LITEREG031_BASE WHERE id = 1;
INSERT INTO LITEREG031_BASE VALUES (5, 'A', 'reused-after-delete');

-- Pending mutations must see one another, and ROLLBACK must restore the index.
BEGIN WORK;
UPDATE LITEREG031_BASE SET code = 'Z' WHERE id = 5;
INSERT INTO LITEREG031_BASE VALUES (6, 'A', 'txn-reuse');
SELECT id, code FROM LITEREG031_BASE WHERE id IN (5, 6) ORDER BY id;
SELECT id, label FROM LITEREG031_BASE WHERE code = 'A' ORDER BY id;
ROLLBACK WORK;
SELECT id, label FROM LITEREG031_BASE WHERE code = 'A' ORDER BY id;

-- UPSERT and MERGE use the same atomic RocksDB table batch as ordinary DML.
BEGIN WORK;
UPSERT INTO LITEREG031_BASE VALUES (5, 'Z', 'upserted');
INSERT INTO LITEREG031_BASE VALUES (6, 'A', 'reused-after-upsert');
MERGE INTO LITEREG031_BASE
USING (SELECT id, code, label FROM LITEREG031_BASE WHERE id = 2) AS source_rows
ON LITEREG031_BASE.id = 5
WHEN MATCHED THEN UPDATE SET code = 'Y', label = 'merged';
COMMIT WORK;

SELECT id, code, label FROM LITEREG031_BASE ORDER BY id;

DROP TABLE LITEREG031_BASE;

-- Failed backfill must not publish the index metadata or leave physical keys.
CREATE TABLE LITEREG031_DUP (id INT NOT NULL PRIMARY KEY, code VARCHAR(8));
INSERT INTO LITEREG031_DUP VALUES (1, 'D'), (2, 'D');
CREATE UNIQUE INDEX LITEREG031_DUP_UX ON LITEREG031_DUP(code);
DELETE FROM LITEREG031_DUP WHERE id = 2;
CREATE UNIQUE INDEX LITEREG031_DUP_UX ON LITEREG031_DUP(code);
DROP INDEX LITEREG031_DUP_UX;
DROP TABLE LITEREG031_DUP;

-- A non-unique equality prefix can return multiple base-table rows.
CREATE TABLE LITEREG031_MULTI
  (id INT NOT NULL PRIMARY KEY, code VARCHAR(8), label VARCHAR(20));
INSERT INTO LITEREG031_MULTI VALUES
  (1, 'G', 'first'), (2, 'G', 'second'), (3, 'H', 'third');
CREATE INDEX LITEREG031_MULTI_IX ON LITEREG031_MULTI(code);
SELECT id, label FROM LITEREG031_MULTI WHERE code = 'G' ORDER BY id;
UPDATE LITEREG031_MULTI SET code = 'H' WHERE id = 2;
SELECT id, label FROM LITEREG031_MULTI WHERE code = 'G' ORDER BY id;
DROP INDEX LITEREG031_MULTI_IX;
DROP TABLE LITEREG031_MULTI;
exit;
