#!/usr/bin/env bash
set -uo pipefail

suite_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
regress_root=$(cd "$suite_dir/.." && pwd)
repo_root=$(cd "$regress_root/../../.." && pwd)
manifest=${LOCAL_LITE_LEGACY_MANIFEST:-$suite_dir/manifest.tsv}
sqlci=${LOCAL_LITE_SQLCI:-$repo_root/core/sql/lib/linux/64bit/debug/sqlci}
sql_lib_dir=${LOCAL_LITE_SQL_LIB_DIR:-$repo_root/core/sql/lib/linux/64bit/debug}
sqf_lib_dir=${LOCAL_LITE_SQF_LIB_DIR:-$repo_root/core/sqf/export/lib64d}
filter=$regress_root/localLite/FILTER
timeout_seconds=${LOCAL_LITE_LEGACY_TIMEOUT:-120}
run_dir=${LOCAL_LITE_LEGACY_RUN_DIR:-}
selected_suite=
probe=0
list_only=0
report_only=0
declare -a requested=()

usage() {
  cat <<'USAGE'
Usage: runregr [options] [TESTnnn|suite/TESTnnn ...]

Options:
  --suite SUITE     select one legacy suite
  --run-dir DIR     retain artifacts in DIR
  --probe           run safe blocked/needs-review entries for baseline evidence
  --list            list selected manifest entries without executing SQLCI
  --report-only     validate the manifest and print inventory totals

With no TEST arguments, only entries marked runnable are selected. Unsafe and
excluded entries are never executed. Each execution uses an isolated RocksDB
store and retains RAW, LOG, normalized EXPECTED, DIFF, and RESULT artifacts.
USAGE
}

fail() {
  echo "runregr: $*" >&2
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --suite)
      [[ $# -ge 2 ]] || fail "--suite requires a value"
      selected_suite=$2
      shift 2
      ;;
    --run-dir)
      [[ $# -ge 2 ]] || fail "--run-dir requires a directory"
      run_dir=$2
      shift 2
      ;;
    --probe) probe=1; shift ;;
    --list) list_only=1; shift ;;
    --report-only) report_only=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; requested+=("$@"); break ;;
    -*) fail "unsupported option: $1" ;;
    *) requested+=("$1"); shift ;;
  esac
done

[[ -f "$manifest" ]] || fail "missing manifest: $manifest"
[[ "$timeout_seconds" =~ ^[1-9][0-9]*$ ]] ||
  fail "LOCAL_LITE_LEGACY_TIMEOUT must be a positive integer"

audit_script=$repo_root/scripts/audit-local-lite-legacy-regress.sh
[[ -x "$audit_script" ]] || fail "missing executable audit script: $audit_script"
"$audit_script" --check >/dev/null || exit 2

if [[ $report_only -eq 1 ]]; then
  exec "$audit_script" --report
fi

[[ -x "$filter" ]] || fail "missing local-lite output filter: $filter"
if [[ $list_only -eq 0 ]]; then
  [[ -x "$sqlci" ]] || fail "missing local-lite sqlci: $sqlci"
  command -v timeout >/dev/null 2>&1 || fail "missing timeout command"
fi

if [[ -z "$run_dir" ]]; then
  run_dir=$(mktemp -d "${TMPDIR:-/tmp}/traf-local-lite-legacy.XXXXXX") || exit 2
else
  mkdir -p "$run_dir" || exit 2
  run_dir=$(cd "$run_dir" && pwd)
fi

normalize_request() {
  local request=$1
  local suite=$selected_suite
  local test_name=$request
  if [[ "$request" == */* ]]; then
    suite=${request%%/*}
    test_name=${request##*/}
  fi
  test_name=$(echo "$test_name" | tr '[:lower:]' '[:upper:]')
  [[ "$test_name" == TEST* ]] || test_name=TEST$test_name
  [[ -n "$suite" ]] || return 1
  printf '%s/%s' "$suite" "$test_name"
}

is_requested() {
  local suite=$1
  local test_name=$2
  if [[ ${#requested[@]} -eq 0 ]]; then
    return 0
  fi
  local request normalized
  for request in "${requested[@]}"; do
    normalized=$(normalize_request "$request") || continue
    [[ "$normalized" == "$suite/$test_name" ]] && return 0
  done
  return 1
}

safe_input() {
  local test_file=$1
  local selector=$2
  local safety_file=$3
  if [[ "$selector" == "all" ]]; then
    cp "$test_file" "$safety_file"
  else
    awk -v wanted=",$selector," '
      BEGIN { active = 0 }
      /^[[:space:]]*\?section[[:space:]]+/ {
        name = $2
        sub(/[;+].*$/, "", name)
        active = index(wanted, "," name ",") > 0
      }
      active { print }
    ' "$test_file" >"$safety_file"
  fi
  ! rg -n -i '^[[:space:]]*(sh|shell)[[:space:]]|TESTABORT|^[[:space:]]*cleanup[[:space:]]+obsolete[[:space:]]+volatile[[:space:]]+tables|^[[:space:]]*obey[[:space:]]+[^;]*\$\$[A-Za-z_][A-Za-z0-9_]*\$\$' "$safety_file" \
    >/dev/null
}

expected_file_for() {
  local source_dir=$1
  local suffix=$2
  local candidate
  for candidate in \
    "$source_dir/EXPECTED$suffix.LOCALLITE" \
    "$source_dir/EXPECTED$suffix.SB" \
    "$source_dir/EXPECTED$suffix.LINUX" \
    "$source_dir/EXPECTED$suffix"; do
    [[ -f "$candidate" ]] && { printf '%s' "$candidate"; return 0; }
  done
  candidate=$(find "$source_dir" -maxdepth 1 -type f \
    -name "EXPECTED$suffix*" | sort | head -1)
  [[ -n "$candidate" ]] || return 1
  printf '%s' "$candidate"
}

selector_slug() {
  echo "$1" | tr ',/' '__' | tr -cd '[:alnum:]_-'
}

append_section() {
  local test_file=$1
  local section=$2
  local driver=$3
  awk -v wanted="$section" '
    BEGIN { active = 0; found = 0 }
    /^[[:space:]]*\?section[[:space:]]+/ {
      name = $2
      sub(/[;+].*$/, "", name)
      active = (name == wanted)
      if (active) found = 1
      next
    }
    active { print }
    END { if (!found) exit 1 }
  ' "$test_file" >>"$driver"
}

select_expected_sections() {
  local expected_file=$1
  local test_name=$2
  local selector=$3
  local output_file=$4
  awk -v selected="$selector" -v test_name="${test_name,,}" '
    BEGIN { active = 0; wanted = tolower("," selected ",") }
    {
      line = $0
      lower = tolower(line)
      if (lower ~ "^>>obey[[:space:]]+" test_name "\\(") {
        section = lower
        sub("^.*" test_name "\\(", "", section)
        sub("\\).*", "", section)
        active = index(wanted, "," section ",") > 0
        next
      }
      if (active && line !~ /^>>log;/ && line !~ /^>>exit;/)
        print line
    }
    END { print ">>exit;" }
  ' "$expected_file" >"$output_file"
}

declare -a selected_rows=()
while IFS=$'\t' read -r suite test_name selector classification milestone disposition blocker evidence; do
  [[ -n "$suite" && "$suite" != \#* ]] || continue
  [[ "$suite" == "suite" && "$test_name" == "test" ]] && continue
  [[ -z "$selected_suite" || "$suite" == "$selected_suite" ]] || continue
  is_requested "$suite" "$test_name" || continue
  if [[ ${#requested[@]} -eq 0 && $list_only -eq 0 &&
        "$disposition" != "runnable" ]]; then
    continue
  fi
  selected_rows+=("$suite"$'\t'"$test_name"$'\t'"$selector"$'\t'"$classification"$'\t'"$milestone"$'\t'"$disposition"$'\t'"$blocker"$'\t'"$evidence")
done <"$manifest"

if [[ ${#selected_rows[@]} -eq 0 ]]; then
  if [[ ${#requested[@]} -gt 0 ]]; then
    fail "no manifest entry matched the requested tests"
  fi
  echo "No runnable legacy entries are currently allowlisted."
  echo "Use --list to inspect a suite or --probe with an explicit safe TEST."
  echo "Artifacts: $run_dir"
  exit 0
fi

echo "Local-lite legacy regress adapter"
echo "  sqlci: $sqlci"
echo "  manifest: $manifest"
echo "  output: $run_dir"

passed=0
failed=0
skipped=0
infrastructure_failed=0

for row in "${selected_rows[@]}"; do
  IFS=$'\t' read -r suite test_name selector classification milestone disposition blocker evidence <<<"$row"
  label="$suite/$test_name[$selector]"

  if [[ $list_only -eq 1 ]]; then
    printf '%s\t%s\t%s\t%s\t%s\n' \
      "$label" "$classification" "$milestone" "$disposition" "$blocker"
    continue
  fi

  if [[ "$disposition" == "excluded" || "$disposition" == "unsafe" ]]; then
    echo "SKIP $label ($disposition: $blocker)"
    skipped=$((skipped + 1))
    continue
  fi
  if [[ "$disposition" != "runnable" && $probe -eq 0 ]]; then
    echo "SKIP $label ($disposition: use --probe for baseline execution)"
    skipped=$((skipped + 1))
    continue
  fi

  source_dir=$regress_root/$suite
  source_test=$source_dir/$test_name
  [[ -f "$source_test" ]] || { echo "FAIL $label (missing TEST)"; failed=$((failed + 1)); continue; }
  suffix=${test_name#TEST}
  expected=$(expected_file_for "$source_dir" "$suffix") || {
    echo "FAIL $label (missing EXPECTED)"
    failed=$((failed + 1))
    continue
  }

  slug="${suite}-${test_name}-$(selector_slug "$selector")"
  case_dir=$run_dir/$slug
  work_dir=$case_dir/work
  store_dir=$case_dir/store
  mkdir -p "$work_dir" "$store_dir"
  cp -a "$source_dir/." "$work_dir/"

  # Legacy TEST drivers commonly OBEY their own sections with a lowercase
  # filename (for example, TEST310 contains "obey test310(ddl)"). Preserve
  # that case-insensitive harness convention on Linux without changing the
  # source suite.
  while IFS= read -r copied_test; do
    copied_name=$(basename "$copied_test")
    lowercase_name=${copied_name,,}
    [[ "$copied_name" == "$lowercase_name" ||
       -e "$work_dir/$lowercase_name" ]] ||
      ln -s "$copied_name" "$work_dir/$lowercase_name"
  done < <(find "$work_dir" -maxdepth 1 -type f -name 'TEST*' | sort)

  safety_file=$case_dir/SAFETY.sql
  if ! safe_input "$source_test" "$selector" "$safety_file"; then
    echo "SKIP $label (unsafe directive detected before SQLCI start)"
    printf 'SKIP\tunsafe-directive\n' >"$case_dir/RESULT.tsv"
    skipped=$((skipped + 1))
    continue
  fi

  if [[ "$selector" == "all" ]]; then
    driver=$test_name
  else
    driver=DRIVER.sql
    : >"$work_dir/$driver"
    IFS=',' read -ra sections <<<"$selector"
    for section in "${sections[@]}"; do
      if ! append_section "$source_test" "$section" "$work_dir/$driver"; then
        echo "FAIL $label (missing section: $section)"
        printf 'FAIL\tmissing-section\t%s\n' "$section" >"$case_dir/RESULT.tsv"
        failed=$((failed + 1))
        continue 2
      fi
    done
    printf 'exit;\n' >>"$work_dir/$driver"
  fi

  raw_file=$case_dir/RAW
  log_file=$case_dir/LOG
  normalized_expected=$case_dir/EXPECTED
  diff_file=$case_dir/DIFF
  result_file=$case_dir/RESULT.tsv

  expected_input=$expected
  if [[ "$selector" != "all" ]]; then
    expected_input=$case_dir/EXPECTED.sections
    select_expected_sections "$expected" "$test_name" "$selector" "$expected_input"
  fi

  (
    cd "$work_dir" || exit 2
    timeout "$timeout_seconds" env \
      LC_ALL=C \
      TRAF_HOME="$repo_root/core/sqf" \
      TRAF_LOCAL_LITE=1 \
      TRAF_LOCAL_STORE_DIR="$store_dir" \
      TEST_CATALOG=TRAFODION \
      TEST_SCHEMA_NAME=SCH \
      TEST_SCHEMA=TRAFODION.SCH \
      REGRTSTDIR="$source_dir" \
      scriptsdir="$regress_root" \
      SQL_MXCI_INITIALIZATION='set schema TRAFODION.SCH' \
      LD_LIBRARY_PATH="$sql_lib_dir:$sqf_lib_dir:${LD_LIBRARY_PATH:-}" \
      "$sqlci" -i "$driver"
  ) >"$raw_file" 2>&1
  sqlci_status=$?

  produced_log=$work_dir/LOG$suffix
  if [[ ! -f "$produced_log" ]]; then
    produced_log=$(find "$work_dir" -maxdepth 1 -type f -iname 'LOG*' | sort | head -1)
  fi
  [[ -n "$produced_log" && -f "$produced_log" ]] || produced_log=$raw_file

  "$filter" "$produced_log" >"$log_file"
  "$filter" "$expected_input" >"$normalized_expected"
  diff -u "$normalized_expected" "$log_file" >"$diff_file"
  diff_status=$?

  first_error=$(rg -m1 -o '\*\*\* ERROR\[[^]]+\]' "$log_file" || true)
  first_sql=$(awk '
    /^>>/ { last = $0 }
    /^\*\*\* ERROR\[/ { print last; exit }
  ' "$log_file")
  first_error=${first_error//$'\t'/ }
  first_sql=${first_sql//$'\t'/ }
  first_error=${first_error//$'\n'/ }
  first_sql=${first_sql//$'\n'/ }

  if [[ $sqlci_status -eq 0 && $diff_status -eq 0 ]]; then
    status=PASS
    passed=$((passed + 1))
  else
    status=FAIL
    failed=$((failed + 1))
  fi
  [[ $sqlci_status -ne 124 ]] || infrastructure_failed=1
  printf 'status\tsqlci\tdiff\tfirst_error\tfirst_sql\n' >"$result_file"
  printf '%s\t%d\t%d\t%s\t%s\n' \
    "$status" "$sqlci_status" "$diff_status" "$first_error" "$first_sql" \
    >>"$result_file"
  echo "$status $label (sqlci=$sqlci_status, diff=$diff_status, first=${first_error:-none})"
done

if [[ $list_only -eq 1 ]]; then
  echo "Artifacts: $run_dir"
  exit 0
fi

echo "Summary: $passed passed, $failed failed, $skipped skipped"
echo "Artifacts: $run_dir"

if [[ $infrastructure_failed -ne 0 ]]; then
  exit 1
fi
if [[ $probe -eq 1 ]]; then
  exit 0
fi
[[ $failed -eq 0 ]]
