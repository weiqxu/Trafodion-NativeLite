-- Portable single-byte CONCAT coverage adapted from charsets/TEST313.
-- Explicit UTF8/UCS2 variants remain outside this case.
SELECT CONCAT('abc', 'def') AS concat_value,
       'abc' || 'def' AS operator_value,
       CASE WHEN CONCAT('', '') = '' THEN 'MATCH' ELSE 'DIFFERENT' END
         AS empty_state,
       CASE WHEN CONCAT(CAST(NULL AS VARCHAR(1)), 'x') IS NULL
            THEN 'NULL' ELSE 'VALUE' END AS null_state,
       CONVERTTOHEX(CONCAT('A ', 'B')) AS trailing_hex
  FROM (VALUES (1)) AS v(n);

CREATE TABLE LLREG023_CONCAT_SOURCE
  (id INT PRIMARY KEY,
   left_txt VARCHAR(8),
   right_txt VARCHAR(8));

INSERT INTO LLREG023_CONCAT_SOURCE VALUES
  (1, 'abc', 'def'),
  (2, '', 'tail'),
  (3, 'head', ''),
  (4, 'A ', 'B'),
  (5, NULL, 'x'),
  (6, 'x', NULL),
  (7, NULL, NULL);

CREATE TABLE LLREG023_CONCAT_RESULTS
  (id INT PRIMARY KEY,
   concat_txt VARCHAR(16),
   operator_txt VARCHAR(16),
   wrapped_txt VARCHAR(18));

-- Cover assignment through both INSERT VALUES and INSERT SELECT, including
-- nested use with the || operator.
INSERT INTO LLREG023_CONCAT_RESULTS VALUES
  (1, CONCAT('abc', 'def'), 'abc' || 'def',
   '[' || CONCAT('abc', 'def') || ']');

INSERT INTO LLREG023_CONCAT_RESULTS
SELECT id,
       CONCAT(left_txt, right_txt),
       left_txt || right_txt,
       '[' || CONCAT(left_txt, right_txt) || ']'
  FROM LLREG023_CONCAT_SOURCE
 WHERE id > 1;

-- Hex output makes empty strings and the preserved embedded space explicit.
SELECT id,
       CASE
         WHEN concat_txt IS NULL AND operator_txt IS NULL THEN 'BOTH_NULL'
         WHEN concat_txt = operator_txt THEN 'MATCH'
         ELSE 'DIFFERENT'
       END AS equality_state,
       CHAR_LENGTH(concat_txt) AS concat_length,
       CONVERTTOHEX(concat_txt) AS concat_hex,
       CONVERTTOHEX(wrapped_txt) AS wrapped_hex
  FROM LLREG023_CONCAT_RESULTS
 ORDER BY id;

-- CONCAT and || remain equivalent in predicates over local-table values.
SELECT id
  FROM LLREG023_CONCAT_SOURCE
 WHERE CONCAT(left_txt, right_txt) = left_txt || right_txt
 ORDER BY id;

SELECT id
  FROM LLREG023_CONCAT_SOURCE
 WHERE CONCAT(left_txt, right_txt) = 'abcdef'
 ORDER BY id;

SELECT id
  FROM LLREG023_CONCAT_SOURCE
 WHERE CONCAT(left_txt, right_txt) = 'A B'
 ORDER BY id;

SELECT id
  FROM LLREG023_CONCAT_RESULTS
 WHERE concat_txt IS NULL
 ORDER BY id;

SELECT id
  FROM LLREG023_CONCAT_RESULTS
 WHERE wrapped_txt = '[' || CONCAT('A ', 'B') || ']'
 ORDER BY id;

DROP TABLE LLREG023_CONCAT_RESULTS;
DROP TABLE LLREG023_CONCAT_SOURCE;
exit;
