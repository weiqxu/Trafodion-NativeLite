-- Portable aggregate/subquery diagnostics adapted from core/TEST002 and
-- executor/TEST002, plus value-evaluation boundaries adapted from core/TEST038.
CREATE TABLE LLREG008_DIAG
  (id INT PRIMARY KEY,
   grp INT,
   text_val VARCHAR(20),
   divisor INT);

INSERT INTO LLREG008_DIAG VALUES
  (1, 10, '12', 2),
  (2, 20, 'bad-number', 0),
  (3, 30, '40000', 5);

-- A multi-column subquery cannot be renamed to one output column.
SELECT (SELECT id, grp FROM LLREG008_DIAG WHERE id = 1) AS pair
  FROM (VALUES(1)) AS one_row(x);

-- Nongrouping columns and incorrectly placed aggregates are rejected.
SELECT id, MAX(grp)
  FROM LLREG008_DIAG;

SELECT id
  FROM LLREG008_DIAG
  WHERE MAX(grp) > 1;

-- An aggregate cannot mix local and outer-scope column references.
SELECT (SELECT i.id
          FROM LLREG008_DIAG AS i
         WHERE MAX(o.grp + i.grp) > 1)
  FROM LLREG008_DIAG AS o;

-- Exercise one successful conversion before the runtime failures.
SELECT CAST(text_val AS INT) AS converted
  FROM LLREG008_DIAG
  WHERE id = 1;

-- Runtime conversion, narrowing, and arithmetic diagnostics.
SELECT CAST(text_val AS INT) AS converted
  FROM LLREG008_DIAG
  WHERE id = 2;

SELECT CAST(text_val AS SMALLINT) AS narrow_val
  FROM LLREG008_DIAG
  WHERE id = 3;

SELECT grp / divisor AS quotient
  FROM LLREG008_DIAG
  WHERE id = 2;

-- All failures must leave the SQLCI session and stored rows usable.
SELECT id, grp, text_val, divisor
  FROM LLREG008_DIAG
  ORDER BY id;

DROP TABLE LLREG008_DIAG;
exit;
