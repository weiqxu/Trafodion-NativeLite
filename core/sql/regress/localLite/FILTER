set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $0 SQLCI_OUTPUT" >&2
  exit 2
fi

# Keep SQL results and diagnostics while removing session-only noise.  Trailing
# spaces and empty lines are normalized so EXPECTED files do not depend on the
# terminal width or SQLCI banner formatting.
sed -E \
  -e 's/[[:space:]]*$//' \
  -e 's/[[:space:]]+MXID[[:alnum:]_]+$/ <MXID>/' \
  -e '/^[[:space:]]*Conversational Interface[[:space:]]*$/d' \
  -e '/^[[:space:]]*Copyright [(]c[)][[:space:]]*$/d' \
  -e '/^>>--/d' \
  -e '/^>>$/d' \
  -e '/^[[:space:]]*End of MXCI Session[[:space:]]*$/d' \
  -e '/^[[:space:]]*$/d' \
  "$1"
