-- Portable datetime-to-string coverage adapted from charsets/TEST313.
CREATE TABLE LLREG017_DATES
  (id INT PRIMARY KEY,
   d DATE);

INSERT INTO LLREG017_DATES VALUES
  (1, DATE '2009-04-15'),
  (2, DATE '2024-02-29'),
  (3, DATE '2026-01-01'),
  (4, NULL);

-- Preserve all three deterministic DATEFORMAT styles.
SELECT DATEFORMAT(DATE '2009-04-15', DEFAULT) AS default_fmt,
       DATEFORMAT(DATE '2009-04-15', USA) AS usa_fmt,
       DATEFORMAT(DATE '2009-04-15', EUROPEAN) AS european_fmt
  FROM (VALUES (1)) AS v(n);

-- Exercise persisted DATE values, a leap day, a year boundary, and NULL.
SELECT id,
       DATEFORMAT(d, USA) AS usa_fmt,
       DAYNAME(d) AS day_name,
       MONTHNAME(d) AS month_name
  FROM LLREG017_DATES
 ORDER BY id;

-- Assignment from generated CHAR values into persisted VARCHAR columns keeps
-- the rendered values and NULL state.
CREATE TABLE LLREG017_DATE_TEXT
  (id INT PRIMARY KEY,
   formatted VARCHAR(20),
   day_name VARCHAR(12),
   month_name VARCHAR(12));

INSERT INTO LLREG017_DATE_TEXT
SELECT id,
       DATEFORMAT(d, EUROPEAN),
       DAYNAME(d),
       MONTHNAME(d)
  FROM LLREG017_DATES;

SELECT id, formatted, day_name, month_name
  FROM LLREG017_DATE_TEXT
 ORDER BY id;

-- Each datetime-to-string function remains usable in a local-table predicate.
SELECT id
  FROM LLREG017_DATES
 WHERE DATEFORMAT(d, USA) = '04/15/2009'
 ORDER BY id;

SELECT id
  FROM LLREG017_DATES
 WHERE DAYNAME(d) = 'Thursday'
 ORDER BY id;

SELECT id
  FROM LLREG017_DATES
 WHERE MONTHNAME(d) = 'February'
 ORDER BY id;

DROP TABLE LLREG017_DATE_TEXT;
DROP TABLE LLREG017_DATES;
exit;
