-- M8 RocksDB-only authorization coverage.

CREATE USER LLREG041_BOB;
CREATE ROLE LLREG041_ROLE;
CREATE TABLE LLREG041_T (id INT PRIMARY KEY, v INT);
INSERT INTO LLREG041_T VALUES (1, 10);

-- Role membership and object privileges are persisted in the RocksDB catalog.
GRANT SELECT, INSERT ON LLREG041_T TO LLREG041_ROLE;
GRANT LLREG041_ROLE TO LLREG041_BOB;

SET SESSION AUTHORIZATION LLREG041_BOB;
VALUES (CURRENT_USER, SESSION_USER, USER);
SELECT id, v FROM LLREG041_T;
INSERT INTO LLREG041_T VALUES (2, 20);
PREPARE LLREG041_P FROM SELECT id FROM LLREG041_T ORDER BY id;
EXECUTE LLREG041_P;

-- The creator owns a new table; ownership permits GRANT, while another
-- authenticated user cannot read or drop it until the owner grants SELECT.
SET SESSION AUTHORIZATION DB__ROOT;
CREATE USER LLREG041_OWNER;
CREATE USER LLREG041_OTHER;
SET SESSION AUTHORIZATION LLREG041_OWNER;
CREATE TABLE LLREG041_OWNED (id INT);
INSERT INTO LLREG041_OWNED VALUES (7);
SET SESSION AUTHORIZATION LLREG041_OTHER;
SELECT id FROM LLREG041_OWNED;
DROP TABLE LLREG041_OWNED;
SET SESSION AUTHORIZATION LLREG041_OWNER;
GRANT SELECT ON LLREG041_OWNED TO LLREG041_OTHER;
SET SESSION AUTHORIZATION LLREG041_OTHER;
SELECT id FROM LLREG041_OWNED;

-- Revoke invalidates the next compilation; the active session cannot read
-- after the role's SELECT privilege is removed.
SET SESSION AUTHORIZATION DB__ROOT;
REVOKE SELECT ON LLREG041_T FROM LLREG041_ROLE;
SET SESSION AUTHORIZATION LLREG041_BOB;
SELECT id FROM LLREG041_T ORDER BY id;
EXECUTE LLREG041_P;

SET SESSION AUTHORIZATION DB__ROOT;
DROP TABLE LLREG041_T;
DROP TABLE LLREG041_OWNED;
DROP ROLE LLREG041_ROLE;
DROP USER LLREG041_BOB;
DROP USER LLREG041_OWNER;
DROP USER LLREG041_OTHER;
exit;
