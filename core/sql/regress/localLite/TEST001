-- Local-lite scalar/table subset adapted from core/TEST038 datetime coverage
-- and executor/TEST063 nullable row coverage.
CREATE TABLE LLREG001_BASE
  (id INT PRIMARY KEY,
   grp INT,
   name VARCHAR(20) NOT NULL,
   amount INT,
   UNIQUE(name));

INSERT INTO LLREG001_BASE VALUES
  (1, 10, 'alpha', 12),
  (2, 10, 'beta',   7),
  (3, 20, 'gamma',  5);

SELECT id, name, amount
  FROM LLREG001_BASE
  ORDER BY id;

SELECT grp, COUNT(*), SUM(amount)
  FROM LLREG001_BASE
  GROUP BY grp
  ORDER BY grp;

SELECT name
  FROM LLREG001_BASE
  WHERE amount BETWEEN 7 AND 13
    AND name IN ('alpha', 'beta')
  ORDER BY name;

SELECT l.name, r.name
  FROM LLREG001_BASE l JOIN LLREG001_BASE r ON l.grp = r.grp
  WHERE l.id = 1
  ORDER BY r.id;

DROP TABLE LLREG001_BASE;

CREATE TABLE LLREG001_DT
  (d DATE, tm TIME, ts TIMESTAMP, label VARCHAR(20));
INSERT INTO LLREG001_DT VALUES
  (DATE '2026-07-03', TIME '12:34:56',
   TIMESTAMP '2026-07-03 12:34:56', 'datetime-hit'),
  (DATE '2026-07-04', TIME '01:02:03',
   TIMESTAMP '2026-07-04 01:02:03', 'datetime-miss');
SELECT label FROM LLREG001_DT WHERE d = DATE '2026-07-03';
SELECT label FROM LLREG001_DT WHERE tm = TIME '12:34:56';
SELECT label FROM LLREG001_DT
  WHERE ts = TIMESTAMP '2026-07-03 12:34:56';
DROP TABLE LLREG001_DT;

CREATE TABLE LLREG001_NULL
  (a INT, b VARCHAR(20), c INT NOT NULL);
INSERT INTO LLREG001_NULL VALUES
  (NULL, 'null-a', 1),
  (2, NULL, 1),
  (1 + 2, CAST('expr' AS VARCHAR(20)), 1);
SELECT b FROM LLREG001_NULL WHERE a IS NULL;
SELECT a FROM LLREG001_NULL WHERE b IS NULL;
SELECT b FROM LLREG001_NULL WHERE a = 3;
DROP TABLE LLREG001_NULL;
exit;
