-- INSERT ... SELECT coverage adapted from executor/TEST001 and TEST002.
CREATE TABLE LLREG010_SOURCE_ROWS
  (id INT PRIMARY KEY,
   grp INT,
   label VARCHAR(20),
   val INT);

CREATE TABLE LLREG010_TARGET_ROWS
  (id INT PRIMARY KEY,
   label VARCHAR(20),
   val INT);

CREATE TABLE LLREG010_CONFLICT_ROWS
  (id INT PRIMARY KEY,
   label VARCHAR(20));

INSERT INTO LLREG010_SOURCE_ROWS VALUES
  (1, 10, 'one', 5),
  (2, 10, 'two', 7),
  (3, 20, 'three', 9);

-- Exercise target-column reordering, source predicates, and expressions.
INSERT INTO LLREG010_TARGET_ROWS (label, id, val)
  SELECT label, id + 10, val * 2
    FROM LLREG010_SOURCE_ROWS
   WHERE grp = 10;

SELECT id, label, val
  FROM LLREG010_TARGET_ROWS
 ORDER BY id;

-- A set-operation source must drive every row through the tuple-flow target.
INSERT INTO LLREG010_TARGET_ROWS
  SELECT id + 20, label, val
    FROM LLREG010_SOURCE_ROWS
   WHERE id = 3
UNION ALL
  SELECT id + 30, label, val
    FROM LLREG010_SOURCE_ROWS
   WHERE id = 1;

SELECT id, label, val
  FROM LLREG010_TARGET_ROWS
 ORDER BY id;

-- INSERT ... SELECT participates in an explicit local transaction.
BEGIN WORK;
INSERT INTO LLREG010_TARGET_ROWS
  SELECT id + 100, label, val
    FROM LLREG010_SOURCE_ROWS;
SELECT id, label, val
  FROM LLREG010_TARGET_ROWS
 WHERE id >= 100
 ORDER BY id;
ROLLBACK WORK;
SELECT COUNT(*) AS rolled_back_rows
  FROM LLREG010_TARGET_ROWS
 WHERE id >= 100;

-- The source emits ids 13 and 14 before colliding with committed id 15.
-- Autocommit tuple-flow rollback must leave neither earlier row behind.
INSERT INTO LLREG010_CONFLICT_ROWS VALUES (15, 'committed');
INSERT INTO LLREG010_CONFLICT_ROWS
  SELECT id + 12, label
    FROM LLREG010_SOURCE_ROWS;

SELECT id, label
  FROM LLREG010_CONFLICT_ROWS
 ORDER BY id;

-- A successful statement after the conflict confirms transaction cleanup.
INSERT INTO LLREG010_CONFLICT_ROWS
  SELECT 99, label
    FROM LLREG010_SOURCE_ROWS
   WHERE id = 1;

SELECT id, label
  FROM LLREG010_CONFLICT_ROWS
 ORDER BY id;

DROP TABLE LLREG010_CONFLICT_ROWS;
DROP TABLE LLREG010_TARGET_ROWS;
DROP TABLE LLREG010_SOURCE_ROWS;
exit;
