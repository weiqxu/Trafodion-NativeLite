-- Portable single-byte SPACE coverage adapted from charsets/TEST004 and
-- charsets/TEST313. Explicit UTF8/UCS2 variants remain outside this case.
SELECT CHAR_LENGTH(SPACE(3)) AS positive_count,
       CHAR_LENGTH(SPACE(0)) AS zero_count,
       CASE WHEN SPACE(CAST(NULL AS INT)) IS NULL
            THEN 'NULL' ELSE 'VALUE' END AS null_state,
       CHAR_LENGTH('L' || SPACE(3) || 'R') AS wrapped_count
  FROM (VALUES (1)) AS v(n);

CREATE TABLE LLREG022_SPACE_COUNTS
  (id INT PRIMARY KEY,
   space_count INT);

INSERT INTO LLREG022_SPACE_COUNTS VALUES
  (2, 0),
  (3, NULL),
  (4, 5);

CREATE TABLE LLREG022_SPACE_RESULTS
  (id INT PRIMARY KEY,
   space_txt VARCHAR(8),
   prefixed_txt VARCHAR(9),
   wrapped_txt VARCHAR(10));

-- Cover assignment through both INSERT VALUES and INSERT SELECT. The latter
-- also exercises a nonconstant count expression.
INSERT INTO LLREG022_SPACE_RESULTS VALUES
  (1, SPACE(3), 'Z' || SPACE(3), 'L' || SPACE(3) || 'R');

INSERT INTO LLREG022_SPACE_RESULTS
SELECT id,
       SPACE(space_count),
       'Z' || SPACE(space_count),
       'L' || SPACE(space_count) || 'R'
  FROM LLREG022_SPACE_COUNTS;

SELECT id,
       CHAR_LENGTH(space_txt) AS space_count,
       CHAR_LENGTH(prefixed_txt) AS prefixed_count,
       CHAR_LENGTH(wrapped_txt) AS wrapped_count,
       CASE WHEN space_txt IS NULL THEN 'NULL' ELSE 'VALUE' END AS value_state
  FROM LLREG022_SPACE_RESULTS
 ORDER BY id;

-- SQL character comparison pads the shorter operand, so all non-NULL
-- all-space values compare equal even though their VARCHAR lengths differ.
SELECT id
  FROM LLREG022_SPACE_RESULTS
 WHERE space_txt = SPACE(3)
 ORDER BY id;

-- Length and wrapped-string predicates distinguish the exact count.
SELECT id
  FROM LLREG022_SPACE_RESULTS
 WHERE CHAR_LENGTH(space_txt) = 3
 ORDER BY id;

SELECT id
  FROM LLREG022_SPACE_RESULTS
 WHERE prefixed_txt = 'Z' || SPACE(3)
 ORDER BY id;

SELECT id
  FROM LLREG022_SPACE_RESULTS
 WHERE wrapped_txt = 'L' || SPACE(3) || 'R'
 ORDER BY id;

-- Preserve the legacy oversized-result diagnostics and session recovery.
SELECT CHAR_LENGTH(SPACE(2147483647)) AS oversized_count
  FROM (VALUES (1)) AS v(n);

SELECT id, CHAR_LENGTH(wrapped_txt) AS recovered_count
  FROM LLREG022_SPACE_RESULTS
 WHERE id = 4;

DROP TABLE LLREG022_SPACE_RESULTS;
DROP TABLE LLREG022_SPACE_COUNTS;
exit;
