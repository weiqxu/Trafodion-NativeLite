-- RocksDB-backed row and statement triggers, BEFORE SET/SIGNAL semantics,
-- multi-trigger ordering metadata, and trigger lifecycle cleanup.

CREATE TABLE LLREG036_T
  (id INT NOT NULL PRIMARY KEY, v INT);
CREATE TABLE LLREG036_AUDIT
  (seq INT NOT NULL PRIMARY KEY, event_name VARCHAR(20), seen_v INT);

CREATE TRIGGER LLREG036_BI BEFORE INSERT ON LLREG036_T
  REFERENCING NEW ROW AS n FOR EACH ROW
  SET n.v = n.v + 1;
CREATE TRIGGER LLREG036_AI AFTER INSERT ON LLREG036_T
  REFERENCING NEW ROW AS n FOR EACH ROW
  INSERT INTO LLREG036_AUDIT VALUES
    (n.id * 10 + 1, 'after-insert', n.v);
INSERT INTO LLREG036_T VALUES (1,10),(2,20);
SELECT * FROM LLREG036_T ORDER BY id;
SELECT * FROM LLREG036_AUDIT ORDER BY seq;
DROP TRIGGER LLREG036_BI;
DROP TRIGGER LLREG036_AI;

CREATE TRIGGER LLREG036_BU BEFORE UPDATE ON LLREG036_T
  REFERENCING OLD ROW AS o, NEW ROW AS n FOR EACH ROW
  SET n.v = n.v + 100;
CREATE TRIGGER LLREG036_AU AFTER UPDATE OF (v) ON LLREG036_T
  REFERENCING OLD ROW AS o, NEW ROW AS n FOR EACH ROW
  INSERT INTO LLREG036_AUDIT VALUES
    (n.id * 10 + 2, 'after-update', n.v);
UPDATE LLREG036_T SET v = v + 1;
SELECT * FROM LLREG036_T ORDER BY id;
SELECT * FROM LLREG036_AUDIT ORDER BY seq;
DROP TRIGGER LLREG036_BU;

CREATE TRIGGER LLREG036_BLOCK BEFORE UPDATE ON LLREG036_T
  REFERENCING OLD ROW AS o, NEW ROW AS n FOR EACH ROW
  WHEN (o.id = 2) SIGNAL SQLSTATE 'S9999' ('blocked');
UPDATE LLREG036_T SET v = v + 1000;
SELECT * FROM LLREG036_T ORDER BY id;
SELECT * FROM LLREG036_AUDIT ORDER BY seq;
DROP TRIGGER LLREG036_BLOCK;
DROP TRIGGER LLREG036_AU;

CREATE TRIGGER LLREG036_AS AFTER INSERT ON LLREG036_T
  FOR EACH STATEMENT
  INSERT INTO LLREG036_AUDIT VALUES (999, 'after-statement', 0);
INSERT INTO LLREG036_T VALUES (3,30),(4,40);
SELECT * FROM LLREG036_AUDIT ORDER BY seq;
DROP TRIGGER LLREG036_AS;
INSERT INTO LLREG036_T VALUES (5,50);
SELECT * FROM LLREG036_AUDIT ORDER BY seq;

DROP TABLE LLREG036_T;
DROP TABLE LLREG036_AUDIT;
exit;
