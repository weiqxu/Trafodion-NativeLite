CREATE TABLE LLREG030_BASE
  (id INT NOT NULL PRIMARY KEY,
   code VARCHAR(8),
   label VARCHAR(20));

INSERT INTO LLREG030_BASE VALUES
  (1, 'A', 'one'),
  (2, 'B', 'two');

CREATE INDEX LLREG030_IX ON LLREG030_BASE(code, id DESC);
CREATE TABLE LLREG030_IX (id INT);
CREATE INDEX LLREG030_IX ON LLREG030_BASE(label);
CREATE INDEX LLREG030_BAD ON LLREG030_BASE(missing_col);
CREATE INDEX LLREG030_DUPCOL ON LLREG030_BASE(code, code);
CREATE UNIQUE INDEX LLREG030_UNIQUE ON LLREG030_BASE(code);

SELECT id, code, label FROM LLREG030_BASE ORDER BY id;

DROP INDEX LLREG030_IX;
CREATE INDEX LLREG030_IX ON LLREG030_BASE(label);

DROP TABLE LLREG030_BASE;

CREATE TABLE LLREG030_OTHER (id INT PRIMARY KEY, label VARCHAR(20));
CREATE INDEX LLREG030_IX ON LLREG030_OTHER(label);
DROP INDEX LLREG030_IX;
DROP INDEX LLREG030_IX;
DROP TABLE LLREG030_OTHER;
exit;
