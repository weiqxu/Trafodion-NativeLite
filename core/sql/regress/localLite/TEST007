-- Portable binder and scalar-subquery diagnostics adapted from core/TEST002
-- and the set-operation shapes in executor/TEST002.
CREATE TABLE LLREG007_DIAG
  (id INT PRIMARY KEY,
   required_val INT NOT NULL,
   label VARCHAR(16));

INSERT INTO LLREG007_DIAG VALUES
  (1, 10, 'alpha'),
  (2, 20, 'beta');

-- INTERSECT and EXCEPT remain disabled by the existing binder default.
SELECT id
  FROM LLREG007_DIAG
INTERSECT
SELECT id
  FROM LLREG007_DIAG;

SELECT id
  FROM LLREG007_DIAG
EXCEPT
SELECT id
  FROM LLREG007_DIAG;

-- UNION operands must have the same degree and compatible data types.
SELECT id
  FROM LLREG007_DIAG
UNION ALL
SELECT id, required_val
  FROM LLREG007_DIAG;

SELECT id
  FROM LLREG007_DIAG
UNION ALL
SELECT DATE '2026-07-31'
  FROM LLREG007_DIAG;

-- INSERT values must match the target degree and NOT NULL contract.
INSERT INTO LLREG007_DIAG VALUES (3, 30);
INSERT INTO LLREG007_DIAG VALUES (3, NULL, 'bad-null');

-- A scalar subquery cannot return more than one row at runtime.
SELECT (SELECT id FROM LLREG007_DIAG) AS scalar_id
  FROM (VALUES(1)) AS one_row(x);

-- Binder/runtime failures must not poison the session or partially insert rows.
SELECT id, required_val, label
  FROM LLREG007_DIAG
  ORDER BY id;

DROP TABLE LLREG007_DIAG;
exit;
