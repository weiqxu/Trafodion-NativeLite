-- RocksDB ordered secondary-index keys for CHAR and floating-point columns.

CREATE TABLE LLREG034_CHAR
  (id INT NOT NULL PRIMARY KEY, code CHAR(4), label VARCHAR(20));
INSERT INTO LLREG034_CHAR VALUES
  (1, 'A', 'char-a'),
  (2, 'AB', 'char-ab'),
  (3, 'B', 'char-b'),
  (4, NULL, 'char-null');
CREATE INDEX LLREG034_CHAR_IX ON LLREG034_CHAR(code DESC);
SELECT id, label FROM LLREG034_CHAR WHERE code = 'AB' ORDER BY id;
SELECT id, label FROM LLREG034_CHAR WHERE code >= 'AB' ORDER BY id;
SELECT id, label FROM LLREG034_CHAR WHERE code IS NULL ORDER BY id;
DROP TABLE LLREG034_CHAR;

CREATE TABLE LLREG034_FLOAT
  (id INT NOT NULL PRIMARY KEY, r REAL, d FLOAT(54),
   label VARCHAR(20));
INSERT INTO LLREG034_FLOAT VALUES
  (1, -10.5, -100.25, 'negative'),
  (2, -0.0, -0.0, 'negative-zero'),
  (3, 0.0, 0.0, 'positive-zero'),
  (4, 1.5, 10.25, 'positive'),
  (5, NULL, NULL, 'null-value');
CREATE INDEX LLREG034_R_IX ON LLREG034_FLOAT(r);
CREATE INDEX LLREG034_D_IX ON LLREG034_FLOAT(d DESC);
SELECT id, label FROM LLREG034_FLOAT WHERE r < 0 ORDER BY id;
SELECT id, label FROM LLREG034_FLOAT WHERE r >= 0 ORDER BY id;
SELECT id, label FROM LLREG034_FLOAT WHERE d > 0 ORDER BY id;
SELECT id, label FROM LLREG034_FLOAT
 WHERE d = CAST(10.25 AS FLOAT(54)) ORDER BY id;
SELECT id, label FROM LLREG034_FLOAT WHERE d IS NULL ORDER BY id;
DROP INDEX LLREG034_R_IX;
DROP TABLE LLREG034_FLOAT;

CREATE TABLE LLREG034_FLOAT_UNIQUE
  (id INT NOT NULL PRIMARY KEY, r REAL);
INSERT INTO LLREG034_FLOAT_UNIQUE VALUES (1, -0.0);
CREATE UNIQUE INDEX LLREG034_FLOAT_UX ON LLREG034_FLOAT_UNIQUE(r);
INSERT INTO LLREG034_FLOAT_UNIQUE VALUES (2, 0.0);
SELECT id FROM LLREG034_FLOAT_UNIQUE ORDER BY id;
DROP TABLE LLREG034_FLOAT_UNIQUE;

exit;
